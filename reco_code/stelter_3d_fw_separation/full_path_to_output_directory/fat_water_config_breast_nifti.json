{
  "cases": [
    {
      "root_path": "path_to_input_directory",

      "outdir": "full_path_to_output_directory",

      "input": {
        "type": "nifti",
        "magnitude_4d": "fl3d_vibe_DIXON_RR_36.nii",
        "phase_4d": "fl3d_vibe_DIXON_RR_37_ph.nii",
        "metadata": "path_to_matlab_metadata_file.mat",
        "phase_units": "radians"
      },

      "slice_subset": {
        "enable": false,
        "out_base": "4D_slices"
      },

      "mask": {
        "mode": "relative",
        "rel_thr": 0.02,
        "fill_holes": true,

        "bias_correction": {
          "enable": true,
          "method": "sitk_n4",
          "debug_export": true,

          "spm": {
            "matlab_cmd": "matlab",
            "matlab_mode": "batch",
            "spm_path": "full_path_to_spm_directory",
            "biasreg": 0.001,
            "biasfwhm": 30,
            "workdir": "_temp/spm_bias_mask",
            "cleanup": false
          },

          "sitk_n4": {
            "max_iterations": [50, 50, 30, 20],
            "convergence_threshold": 0.001,
            "otsu_bins": 200
          }
}
,

        "precomputed": {
          "enable": false,
          "path": "",
          "path_is_relative_to": "root",
          "threshold": 0.5,
          "invert": false,
          "resample": "auto"
        }
      },

      "fat_model": {
        "frequency_reference": "water_peak",
        "main_fat_peak_ppm": -3.30,
        "freqs_ppm": [-3.70, -3.30, -3.01, -2.57, -2.35, -1.83, 0.71],
        "rel_amps":  [0.0847, 0.6257, 0.0707, 0.0952, 0.0662, 0.0159, 0.0418]
      },

      "echo_subset": {
        "min_te_s": null,
        "max_te_s": null,
        "n_echoes": null
      },


      "hmrgc": {
        "use_gpu": true,
        "r2star_correction": false,
        "sampling_stepsize_fm": 10.0,
        "sampling_stepsize_r2s": 30.0,
        "PPM2HZ": null,
        "range_fm_ppm": [-1.5, 1.5]
      }
    }
  ]
}