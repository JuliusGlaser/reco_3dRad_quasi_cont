{
  "cases": [
    {
      "root_path": "/path/to/your/data",

      "outdir": "path/to/out/dir/Phantom_20k_30_win_us4_3Dgc_multi_res",
      "output": {"measurement_id": null},

      "input": {
        "type": "nifti",
        "magnitude_4d": "initially_reconstructed_filtered_meas_MID00101_FID01005_MR_DA_3D_RAD_20k_1000mum.dat_win_4000_steps_30_us_4_C_17_FOV_200_ppm_0_abs.nii",
        "phase_4d": "initially_reconstructed_filtered_meas_MID00101_FID01005_MR_DA_3D_RAD_20k_1000mum.dat_win_4000_steps_30_us_4_C_17_FOV_200_ppm_0_phs.nii",
        "metadata": "path/to/meas_MID00101_FID01005_MR_DA_3D_RAD_20k_1000mum.dat_win_4000_steps_30_us_4_C_17_FOV_200_ppm_0_metadata.mat",
        "phase_units": "radians"
      },

      "slice_subset": {
        "enable": false,
        "mode": "range",
        "z_start": 55,
        "z_end": 150,
        "indexing": "0based",
        "out_base": "4D_slices"
      },

      "mask": {
        "mode": "relative",
        "rel_thr": 0.001,
        "fill_holes": true,

        "bias_correction": {
          "enable": false,
          "method": "sitk_n4",
          "debug_export": true,

          "spm": {
            "matlab_cmd": "matlab",
            "matlab_mode": "batch",
            "spm_path": "/some/path",
            "biasreg": 0.001,
            "biasfwhm": 30,
            "workdir": "_temp/spm_bias_mask",
            "cleanup": false
          },

          "sitk_n4": {
            "max_iterations": [50, 50, 30, 20],
            "convergence_threshold": 0.001,
            "otsu_bins": 200
          }
}
,

        "precomputed": {
          "enable": false,
          "path": "/some/path",
          "path_is_relative_to": "root",
          "threshold": 0.5,
          "invert": false,
          "resample": "auto"
        }
      },

      "fat_model": {
        "freqs_ppm": [-3.926, -3.5, -3.211, -2.782, -2.563, -2.037, -0.724, -0.510, 0.513],
        "rel_amps":  [0.0879, 0.6478, 0.0130, 0.0936, 0.0468, 0.0031, 0.0230, 0.0158, 0.0690]
      },

      "echo_subset": {
        "min_te_s": null,
        "max_te_s": null,
        "n_echoes": null
      },


      "hmrgc": {
        "use_gpu": true,
        "r2star_correction": false,
        "sampling_stepsize_fm": 1.0,
        "sampling_stepsize_r2s": 1.0,
        "PPM2HZ": null,

        "multi_echo_override": {
          "default_layer_options": {
            "reg_param": 0.001,
            "smoothing": true,
            "smoothing_sigma": 1.2,
            "noise_weighting_intra_edges": true
          },
          "methods": {
            "single-res": [
              {
                  "name": "Fieldmap",
                  "type": "fieldmap"
              },
              {
                  "name": "R2starmap",
                  "type": "r2starmap"
              },
              {
                  "name": "Images",
                  "type": "images"
              }
            ],

            "multi-res": [
              {
                  "name": "Unwrapping",
                  "type": "fieldmap",
                  "voxelSize_mm": [5.5, 5.5, 5.5],
                  "reg_param": 1e-4,
                  "smoothing": true
              },
              {
                  "name": "Mid-res",
                  "type": "fieldmap",
                  "voxelSize_mm": [1.5, 1.5, 1.5],
                  "prior": {
                      "layer_for_range": 0,
                      "layer_for_insert": [],
                      "neighborhood_for_range": [2.5, 2.5]
                  },
                  "smoothing": true
              },
              {
                  "name": "High-res",
                  "type": "fieldmap",
                  "prior": {
                      "layer_for_range": 1,
                      "layer_for_insert": [1],
                      "neighborhood_for_range": [0.8, 0.8],
                      "neighborhood_for_insert": [0.4, 0.4]
                  }
              },
              {
                  "name": "R2starmap",
                  "type": "r2starmap"
              },
              {
                  "name": "Images",
                  "type": "images"
              }
            ],

            "breast": [
              {
                "name": "Unwrapping (WF)",
                "reg_param": 1e-5,
                "voxelSize_mm": [6.0, 6.0, 6.0]
              },
              {
                "name": "Mid-res (WF)",
                "prior": {
                  "neighborhood_for_range": [2.0, 2.0]
                }
              }
            ]
          },

          "default_method": {
            "WF": "multi-res"
          }
        }
      }
    }
  ]
}